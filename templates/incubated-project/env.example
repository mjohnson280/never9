# __NAME__ — environment template
#
# Copy to .env.local and fill in real values. Never commit .env.local.
# Every variable the app reads must be listed here with an empty or dummy value.
# Add a line here in the same commit that introduces any new process.env read.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never referenced from client components or NEXT_PUBLIC_* names.
SUPABASE_SERVICE_ROLE_KEY=
# Local CLI / migrations
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI ---
ANTHROPIC_API_KEY=
